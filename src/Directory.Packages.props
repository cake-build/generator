<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <Verify_SponsorshipExemption>OpenSource</Verify_SponsorshipExemption>
    <Verify_SponsorshipExemptionUntil>$([System.DateTime]::UtcNow.AddMonths(6).ToString('yyyy-MM'))</Verify_SponsorshipExemptionUntil>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Cake.Core" Version="7.0.0-alpha0172" />
    <PackageVersion Include="Cake.Common" Version="7.0.0-alpha0172" />
    <PackageVersion Include="Cake.Cli" Version="7.0.0-alpha0172" />
    <PackageVersion Include="Cake.DotNetTool.Module" Version="7.0.0-alpha0172" />
    <PackageVersion Include="Cake.NuGet" Version="7.0.0-alpha0172" />
    <PackageVersion Include="Cake.Twitter" Version="6.0.0" />
    <PackageVersion Include="Cake.BuildSystems.Module" Version="9.0.0" />
    <PackageVersion Include="Cake.Docker" Version="1.5.0" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <PackageVersion Include="Spectre.Console.Cli" Version="0.57.2" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <!-- Test dependencies -->
    <PackageVersion Include="TUnit" Version="1.75.0" />
    <PackageVersion Include="Verify.TUnit" Version="33.3.4" />
    <PackageVersion Include="Verify.SourceGenerators" Version="2.5.0" />
  </ItemGroup>
</Project>